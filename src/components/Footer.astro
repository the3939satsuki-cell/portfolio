---
const socials = [
  { href: 'https://instagram.com/', label: 'instagram' },
  { href: 'https://x.com/', label: 'x' },
  { href: 'https://www.behance.net/', label: 'behance' },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap reveal-up">
    <span class="label">Get in touch</span>
    <a class="footer__cta display display--xl" href="/contact">let's make something <span class="accent">together.</span></a>
    <div class="footer__row">
      <span class="label">© {year} goto satsuki</span>
      <nav class="footer__soc">
        {socials.map((s) => (<a data-mag href={s.href} target="_blank" rel="noopener">{s.label}</a>))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer { padding: clamp(72px, 12vh, 150px) 0 48px; }
  .footer__cta { display: inline-block; margin: 18px 0 0; }
  .footer__row { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--line); }
  .footer__soc { display: flex; gap: 26px; }
  .footer__soc a { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
