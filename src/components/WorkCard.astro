---
interface Props {
  href: string;
  num: string;
  title: string;
  category: string;
  cover?: string;
}
const { href, num, title, category, cover } = Astro.props;
---
<a class="card" href={href} data-category={category}>
  <div class="card__meta">
    <span class="card__num neon">{num}</span>
    <span class="label">{category}</span>
  </div>
  <div class="card__media">
    {cover
      ? <img src={cover} alt={title} loading="lazy" />
      : <span class="card__ph mono">NO IMAGE</span>}
  </div>
  <div class="card__foot">
    <span class="card__title">{title}</span>
    <span class="card__arrow neon">↗</span>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; border: 1px solid var(--border); background: var(--bg); transition: background .2s; }
  .card:hover { background: #0f0f0f; }
  .card:hover .card__media img { transform: scale(1.04); }
  .card:hover .card__arrow { transform: translate(3px, -3px); }
  .card__meta { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 16px; }
  .card__num { font-family: var(--font-mono); font-weight: 700; font-size: 15px; }
  .card__media { position: relative; aspect-ratio: 16 / 10; background: var(--surface); overflow: hidden; display: grid; place-items: center; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .card__ph { color: #3a3a3a; font-size: 13px; letter-spacing: 0.2em; }
  .card__foot { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 22px; }
  .card__title { font-family: var(--font-mono); font-weight: 700; font-size: 19px; }
  .card__arrow { font-size: 18px; transition: transform .25s ease; }
</style>
