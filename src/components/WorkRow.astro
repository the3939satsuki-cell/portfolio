---
interface Props {
  href: string;
  num: string;
  name: string;
  categories: string[];
  cover?: string;
  grad: string;
}
const { href, num, name, categories, cover, grad } = Astro.props;
---
<a class="work-item" href={href} data-num={num} data-grad={grad} data-cover={cover} data-categories={categories.join(',')}>
  <span class="work-item__num">{num}</span>
  <span class="work-item__name">{name}</span>
  <span class="work-item__cat label">{categories.join(' / ')}</span>
</a>
