---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'GOTO SATSUKI — Portfolio',
  description = 'Visual artist — illustration & motion. 後藤颯希のポートフォリオ。',
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="preloader" class="preloader" role="status" aria-label="読み込み中">
      <div class="preloader__inner">
        <div class="preloader__num" aria-hidden="true">
          <span class="preloader__num-base" id="preNumBase">0</span>
          <span class="preloader__num-fill" id="preNumFill">0</span>
        </div>
        <div class="preloader__label">Satsuki Goto</div>
      </div>
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <div class="reveal-img" id="revealImg"><span class="reveal-img__num" id="revealNum"></span></div>
    <div class="cursor" id="cursor"></div>
    <div class="cursor-txt" id="cursorTxt">view</div>

    <script>
      // ===== プリローダー：数字が下から満ちていくローディング画面 =====
      (function () {
        const pre = document.getElementById('preloader');
        if (pre) {
          const numBase = document.getElementById('preNumBase');
          const numFill = document.getElementById('preNumFill');
          const imgs = Array.from(document.querySelectorAll('img')).filter((i) => i.loading !== 'lazy');
          const total = imgs.length;
          let loaded = 0;
          let done = false;
          let shown = 0;
          const setPct = (pct: number) => {
            if (numBase) numBase.textContent = String(pct);
            if (numFill) { numFill.textContent = String(pct); numFill.style.clipPath = `inset(${100 - pct}% 0 0 0)`; }
          };
          const target = () => (total === 0 ? 100 : Math.round((loaded / total) * 100));
          const finish = () => {
            if (done) return;
            done = true;
            setTimeout(() => { pre.classList.add('hide'); document.body.classList.remove('is-loading'); }, 550);
          };
          document.body.classList.add('is-loading');
          const tick = () => {
            const t = done ? 100 : target();
            if (shown < t) shown = Math.min(t, shown + Math.max(1, Math.ceil((t - shown) / 6)));
            setPct(shown);
            if (!(done && shown >= 100)) requestAnimationFrame(tick);
          };
          tick();
          imgs.forEach((img) => {
            if (img.complete) { loaded++; }
            else {
              img.addEventListener('load', () => { loaded++; if (loaded >= total) finish(); }, { once: true });
              img.addEventListener('error', () => { loaded++; if (loaded >= total) finish(); }, { once: true });
            }
          });
          if (loaded >= total) finish();
          window.addEventListener('load', finish);
          setTimeout(finish, 6000);
        }
      })();

      const fine = window.matchMedia('(pointer:fine)').matches;
      const revealImg = document.getElementById('revealImg') as HTMLElement;
      const revealNum = document.getElementById('revealNum') as HTMLElement;
      const cursor = document.getElementById('cursor') as HTMLElement;
      const cursorTxt = document.getElementById('cursorTxt') as HTMLElement;
      const mouse = { x: innerWidth / 2, y: innerHeight / 2 };
      const rev = { x: mouse.x, y: mouse.y };
      const cur = { x: mouse.x, y: mouse.y };
      if (fine) document.body.classList.add('cur');

      window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });

      // 作品ホバーで画像が現れ、カーソルに追従
      document.querySelectorAll<HTMLElement>('.work-item').forEach((it) => {
        it.addEventListener('mouseenter', () => {
          const cover = it.dataset.cover;
          revealImg.style.background = cover
            ? `#111 url("${cover}") center/cover`
            : (it.dataset.grad || '#111');
          revealNum.textContent = it.dataset.num || '';
          revealNum.style.display = cover ? 'none' : 'grid';
          revealImg.classList.add('show');
          cursor.classList.add('big');
          cursorTxt.style.opacity = '1';
        });
        it.addEventListener('mouseleave', () => {
          revealImg.classList.remove('show');
          cursor.classList.remove('big');
          cursorTxt.style.opacity = '0';
        });
      });

      // マグネティック
      document.querySelectorAll<HTMLElement>('[data-mag]').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          const mx = e.clientX - (r.left + r.width / 2);
          const my = e.clientY - (r.top + r.height / 2);
          el.style.transform = `translate(${mx * 0.4}px, ${my * 0.5}px)`;
        });
        el.addEventListener('mouseleave', () => { el.style.transform = ''; });
      });

      // スクロールで立ち上がる
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal-up').forEach((el) => io.observe(el));

      const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
      (function loop() {
        rev.x = lerp(rev.x, mouse.x, 0.12); rev.y = lerp(rev.y, mouse.y, 0.12);
        revealImg.style.left = rev.x + 'px'; revealImg.style.top = rev.y + 'px';
        cur.x = lerp(cur.x, mouse.x, 0.25); cur.y = lerp(cur.y, mouse.y, 0.25);
        cursor.style.left = cur.x + 'px'; cursor.style.top = cur.y + 'px';
        cursorTxt.style.left = cur.x + 'px'; cursorTxt.style.top = cur.y + 'px';
        requestAnimationFrame(loop);
      })();
    </script>
  </body>
</html>
