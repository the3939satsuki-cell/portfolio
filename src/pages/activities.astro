---
import Base from '../layouts/Base.astro';

const activities = [
  { name: 'life is tech', role: 'メンター / アニメーションコース担当', period: '2025—', desc: '中高生に4日間でAEなどのアニメーション技術を教える。' },
  { name: '丸井グループ　長期インターン', role: 'youtube編集 / イベントフライヤー,web制作 / イベント映像制作', period: '2026—', desc: 'イベント用のオープニング映像、ポスターなどを制作。' },
];
---
<Base title="Activities — GOTO SATSUKI">
  <section class="wrap head">
    <span class="label">Extracurricular</span>
    <h1 class="display display--xl">課外活動</h1>
  </section>

  <section class="wrap section">
    <ul class="list">
      {activities.map((a, i) => (
        <li class="row reveal-up">
          <span class="row__num display display--sm">{String(i + 1).padStart(2, '0')}</span>
          <div class="row__body">
            <div class="row__top">
              <h2 class="row__name display display--sm">{a.name}</h2>
              <span class="label">{a.period}</span>
            </div>
            <p class="row__role label">{a.role}</p>
            <p class="row__desc">{a.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { padding-block: clamp(140px, 22vh, 240px) 0; }
  .head .display { margin-top: 12px; text-transform: none; }
  .section { padding-block: clamp(44px, 8vh, 90px) clamp(72px, 12vh, 150px); }
  .list { list-style: none; }
  .row { display: flex; gap: clamp(24px, 5vw, 72px); padding: clamp(34px, 5vh, 54px) 0; border-top: 1px solid var(--line); }
  .row__num { color: var(--accent); }
  .row__name { text-transform: none; }
  .row__top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .row__role { margin: 14px 0; }
  .row__desc { color: #33322d; max-width: 52ch; }
  @media (max-width: 600px) { .row { gap: 16px; } .row__top { flex-direction: column; gap: 6px; } }
</style>
