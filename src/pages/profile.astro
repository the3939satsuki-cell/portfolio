---
import Base from '../layouts/Base.astro';

// 差し替え用アセット（public/ 直下）。ロゴマーク・写真を置き換えるときはここのパスと合わせてください。
const photo = '/ptofile.jpg'; // 実際の写真は profile.jpg 等を public/ に置き、このパスを '/profile.jpg' に変更
const mark = '/mark.svg';     // ロゴマークSVGを public/mark.svg に上書きすれば差し替わります

const skills = [
  'デザイン', '映像制作', 'モーショングラフィックス', 'イラストレーション',
  'Photoshop', 'Illustrator', 'After Effects', 'Procreate', 'DaVinci Resolve', 'Blender',
];
const timeline = [
  { year: '2026', text: 'フリーランスのビジュアルアーティストとして活動開始' },
  { year: '2025', text: '学内外のプロジェクトで作品制作・展示' },
  { year: '2024', text: 'イラスト・モーション制作を本格的にスタート' },
];
---
<Base title="Profile — GOTO SATSUKI">
  <section class="wrap head">
    <span class="label">About</span>
    <h1 class="display display--xl">profile</h1>
  </section>

  <section class="wrap intro">
    <div class="col col--photo reveal-up">
      <div class="photo"><img src={photo} alt="後藤颯希" /></div>
      <p class="name">後藤　颯希</p>
    </div>

    <div class="col col--about reveal-up">
      <img class="mark" src={mark} alt="ロゴマーク" />
      <p class="mark-name">Satsuki Goto</p>
      <p class="univ">多摩美術大学　情報デザイン学科<br />情報デザインコース在籍</p>
      <p class="bio">「新しいデザイン」を作るため<br />グラフィックデザイン、映像制作<br />パッケージデザイン、<br />モーショングラフィックスなど<br />幅広い分野を学んでいます。</p>
    </div>

    <aside class="col col--skills reveal-up">
      <span class="label">Skills</span>
      <ul class="skills">{skills.map((s) => (<li>{s}</li>))}</ul>
    </aside>
  </section>

  <section class="wrap section reveal-up">
    <span class="label">Timeline</span>
    <ul class="timeline">
      {timeline.map((t) => (
        <li class="tl">
          <span class="tl__year display display--sm">{t.year}</span>
          <span class="tl__text">{t.text}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { padding-block: clamp(140px, 22vh, 240px) 0; }
  .head .display { margin-top: 12px; }

  .intro {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: clamp(32px, 5vw, 72px);
    align-items: start; padding-block: clamp(52px, 9vh, 100px);
    border-top: 1px solid var(--line); margin-top: 44px;
  }
  .col--photo { display: flex; flex-direction: column; align-items: center; }
  .photo { width: 100%; max-width: 340px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--bg-soft, #e6e3da); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .name { margin-top: 34px; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 300; letter-spacing: 0.16em; }

  .col--about { text-align: center; }
  .mark { height: 130px; width: auto; margin: 6px auto 10px; }
  .mark-name { font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.12em; color: var(--ink); }
  .univ { margin-top: 44px; font-size: 15px; line-height: 2; color: #33322d; }
  .bio { margin-top: 30px; font-size: 15px; line-height: 2; color: #4a4842; }

  .col--skills { }
  .skills { list-style: none; margin-top: 18px; }
  .skills li { font-size: 16px; padding: 15px 0; border-bottom: 1px solid var(--line); color: #33322d; }

  .section { padding-block: clamp(48px, 8vh, 90px) clamp(72px, 12vh, 150px); }
  .timeline { list-style: none; margin-top: 22px; }
  .tl { display: flex; gap: clamp(20px, 4vw, 60px); padding: 28px 0; border-top: 1px solid var(--line); align-items: baseline; }
  .tl__year { color: var(--accent); min-width: 120px; }
  .tl__text { color: #33322d; }

  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; gap: 56px; }
    .col--photo { max-width: 360px; margin-inline: auto; }
  }
</style>
