---
import Base from '../layouts/Base.astro';

const skills = [
  'イラストレーション', 'キャラクターデザイン', 'モーショングラフィックス',
  'アートディレクション', 'Photoshop', 'Illustrator', 'After Effects', 'Procreate',
];
const timeline = [
  { year: '2026', text: 'フリーランスのビジュアルアーティストとして活動開始' },
  { year: '2025', text: '学内外のプロジェクトで作品制作・展示' },
  { year: '2024', text: 'イラスト・モーション制作を本格的にスタート' },
];
---
<Base title="Profile — GOTO SATSUKI">
  <section class="wrap head">
    <span class="label"><span class="neon">✳</span>&nbsp; ABOUT</span>
    <h1 class="display display--md">PROFILE</h1>
  </section>

  <section class="wrap grid2">
    <div class="bio">
      <p class="lead">後藤颯希（さつき）。イラストとモーションを軸に活動するビジュアルアーティストです。</p>
      <p>静止画と動きの境界にあるビジュアルづくりが好きで、鮮やかな色と大胆な構図で「思わず目が留まる」表現を追いかけています。ここに自己紹介の文章を自由に書き換えてください。</p>
    </div>
    <aside class="skills">
      <span class="label">SKILLS</span>
      <ul>
        {skills.map((s) => (<li class="mono">{s}</li>))}
      </ul>
    </aside>
  </section>

  <section class="wrap section">
    <span class="label">TIMELINE</span>
    <ul class="timeline">
      {timeline.map((t) => (
        <li class="tl">
          <span class="tl__year neon mono">{t.year}</span>
          <span class="tl__text">{t.text}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { padding-block: 56px 24px; }
  .grid2 { display: grid; grid-template-columns: 2fr 1fr; gap: 48px; padding-block: 40px 0; border-top: 2px solid var(--border); padding-top: 48px; }
  .lead { font-size: 24px; line-height: 1.5; margin-bottom: 24px; }
  .bio p { line-height: 1.8; color: #cfcfcf; margin-bottom: 18px; max-width: 640px; }
  .skills ul { list-style: none; margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
  .skills li { font-size: 15px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .section { padding-block: 72px; }
  .timeline { list-style: none; margin-top: 20px; }
  .tl { display: flex; gap: 32px; padding: 24px 0; border-top: 1px solid var(--border); }
  .tl__year { font-size: 18px; font-weight: 700; min-width: 80px; }
  .tl__text { line-height: 1.6; color: #cfcfcf; }
  @media (max-width: 720px) { .grid2 { grid-template-columns: 1fr; } .tl { flex-direction: column; gap: 8px; } }
</style>
