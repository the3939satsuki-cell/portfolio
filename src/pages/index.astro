---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('works')).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const featured = all.filter((w) => w.data.featured).slice(0, 6);
const list = featured.length ? featured : all.slice(0, 6);
---
<Base>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero__meta">
      <span class="label">GOTO SATSUKI — VISUAL ARTIST</span>
      <span class="label">(ILLUSTRATION / MOTION)</span>
    </div>
    <h1 class="display hero__headline">
      MAKING<br />THINGS<br /><span class="neon">THAT MOVE.</span>
    </h1>
  </section>

  <Marquee />

  <!-- FEATURED WORKS -->
  <section class="wrap section">
    <div class="section__head">
      <span class="label"><span class="neon">✳</span>&nbsp; SELECTED INDEX</span>
      <span class="label">{String(list.length).padStart(2, '0')} PROJECTS</span>
    </div>
    <div class="grid">
      {list.map((w, i) => (
        <WorkCard
          href={`/works/${w.id}`}
          num={String(i + 1).padStart(2, '0')}
          title={w.data.title}
          category={w.data.category}
          cover={w.data.cover}
        />
      ))}
    </div>
    <a class="viewall mono link-underline" href="/works">VIEW ALL WORKS ↗</a>
  </section>
</Base>

<style>
  .hero { padding-block: 64px 56px; }
  .hero__meta { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .hero__headline { margin: 0; }
  .section { padding-block: 80px; }
  .section__head { display: flex; justify-content: space-between; align-items: center; padding: 30px 0; border-top: 2px solid var(--border); border-bottom: 2px solid var(--border); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: -1px; }
  .grid > :global(.card) { margin: -0.5px; }
  .viewall { display: inline-block; margin-top: 40px; font-size: 15px; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .hero__meta { flex-direction: column; gap: 8px; } }
</style>
