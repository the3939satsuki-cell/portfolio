---
import Base from '../layouts/Base.astro';
import WorkRow from '../components/WorkRow.astro';
import { getWorks } from '../lib/works';

const works = await getWorks();
const featured = works.filter((w) => w.entry.data.featured);
const list = (featured.length ? featured : works).slice(0, 6);
---
<Base>
  <header class="hero">
    <div class="wrap">
      <span class="label hero__eyebrow">Visual artist — portfolio 2026</span>
      <h1 class="display display--xl hero__title">design<br />&amp; motion, <span class="accent">by satsuki.</span></h1>
      <p class="lead hero__intro">「新しいデザイン」を追い続ける。</p>
    </div>
  </header>

  <section class="works">
    <div class="wrap">
      <div class="works__head">
        <span class="label">Selected works</span>
        <span class="label">( {String(list.length).padStart(2, '0')} )</span>
      </div>
      <ul class="worklist">
        {list.map((w) => (
          <WorkRow
            href={`/works/${w.entry.id}`}
            num={w.num}
            name={w.entry.data.title}
            categories={w.entry.data.category}
            cover={w.entry.data.cover}
            grad={w.grad}
          />
        ))}
      </ul>
      <a class="all label ul" href="/works">all works ↗</a>
    </div>
  </section>

  <div class="marquee">
    <div class="marquee__t">
      <span>design <b>✦</b> motion <b>✦</b> graphic <b>✦</b> design <b>✦</b> motion <b>✦</b> graphic <b>✦</b> </span>
      <span>design <b>✦</b> motion <b>✦</b> graphic <b>✦</b> design <b>✦</b> motion <b>✦</b> graphic <b>✦</b> </span>
    </div>
  </div>

  <section class="wrap about reveal-up">
    <p class="lead about__t">タイポグラフィ、パッケージ、グラフィック、インタラクションなど様々なデザインを学び続ける。
      <a class="ul accent" href="/profile">プロフィールを見る ↗</a></p>
  </section>
</Base>

<style>
  .hero { padding: clamp(150px, 22vh, 260px) 0 clamp(56px, 9vh, 110px); }
  .hero__eyebrow { display: block; margin-bottom: 26px; }
  .hero__title { margin: 0; }
  .hero__intro { margin-top: 34px; }
  .works { padding: clamp(24px, 4vh, 60px) 0 clamp(60px, 10vh, 120px); border-top: 1px solid var(--line); }
  .works__head { display: flex; justify-content: space-between; align-items: baseline; padding: 24px 0 6px; }
  .all { display: inline-block; margin-top: 30px; }
  .about { padding-block: clamp(64px, 11vh, 140px); }
  .about__t { max-width: 32ch; }
</style>
